# Copy to infra/oracle/.env on the VM. Generate unique 32+ byte hex secrets.
# Never commit the populated .env, and do not reuse the local development passwords.
POSTGRES_ADMIN_PASSWORD=replace-with-unique-hex-secret
SC_IDENTITY_DB_PASSWORD=replace-with-unique-hex-secret
SC_SCHOOL_DB_PASSWORD=replace-with-unique-hex-secret
SC_CONTENT_DB_PASSWORD=replace-with-unique-hex-secret
SC_ATTENDANCE_DB_PASSWORD=replace-with-unique-hex-secret
SC_FILES_DB_PASSWORD=replace-with-unique-hex-secret
SC_NOTIFICATIONS_DB_PASSWORD=replace-with-unique-hex-secret
SC_AUDIT_DB_PASSWORD=replace-with-unique-hex-secret
INTERNAL_SERVICE_TOKEN=replace-with-unique-hex-secret
AUTH_JWT_SECRET=replace-with-unique-hex-secret

# Enable ONLY for synthetic, access-restricted testing. Never load demo data for a real school.
SC_DEMO_SEED=false
DEVELOPMENT_OTP_CODE=123456
API_LOOPBACK_PORT=3000
CORS_ALLOWED_ORIGINS=

# OCI private Object Storage bucket and S3-compatible customer secret key.
S3_ENDPOINT=https://NAMESPACE.compat.objectstorage.REGION.oci.customer-oci.com
S3_REGION=REGION
S3_BUCKET=schoolconnect-trial-private
S3_ACCESS_KEY_ID=replace-with-oci-customer-access-key
S3_SECRET_ACCESS_KEY=replace-with-oci-customer-secret-key
