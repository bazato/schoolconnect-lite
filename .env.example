IDENTITY_DATABASE_URL=postgresql://schoolconnect:schoolconnect@localhost:5432/schoolconnect_identity
SCHOOL_DATABASE_URL=postgresql://schoolconnect:schoolconnect@localhost:5432/schoolconnect_school
CONTENT_DATABASE_URL=postgresql://schoolconnect:schoolconnect@localhost:5432/schoolconnect_content
ATTENDANCE_DATABASE_URL=postgresql://schoolconnect:schoolconnect@localhost:5432/schoolconnect_attendance
FILE_DATABASE_URL=postgresql://schoolconnect:schoolconnect@localhost:5432/schoolconnect_files
NOTIFICATION_DATABASE_URL=postgresql://schoolconnect:schoolconnect@localhost:5432/schoolconnect_notifications
AUDIT_DATABASE_URL=postgresql://schoolconnect:schoolconnect@localhost:5432/schoolconnect_audit
READ_DATABASE_URL=postgresql://schoolconnect:schoolconnect@localhost:5432/schoolconnect_read
AUTHORIZATION_PROVIDER=local-jwt
RESOURCE_AUTHORIZATION_PROVIDER=policy
# AUTHORIZATION_RESOURCE_ROLES_JSON={"TEACHER_CLASS":["TEACHER"],"GUARDIAN_CHILD":["PARENT"]}
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_JWT_ISSUER=schoolconnect-identity
AUTH_JWT_AUDIENCE=schoolconnect-mobile
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_SESSION_IDLE_TTL_DAYS=7
INTERNAL_SERVICE_TOKEN=replace-with-a-different-32-character-random-secret
OTP_PROVIDER=development
DEVELOPMENT_OTP_CODE=123456
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_SECONDS=900
OTP_RESEND_AFTER_SECONDS=30
# Optional separate stable pepper; otherwise Identity uses AUTH_JWT_SECRET.
# Never rotate the pepper without a credential-reset plan.
# PASSCODE_PEPPER=replace-with-a-different-32-character-random-secret
PASSCODE_MAX_ATTEMPTS=5
PASSCODE_LOCK_SECONDS=900
PASSCODE_LOGIN_LIMIT=30
API_AUTH_RATE_LIMIT=120
API_USER_RATE_LIMIT=600
API_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
ENFORCE_HTTPS=false
DB_CONNECTION_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=5000
IDENTITY_DB_POOL_MAX=10
SCHOOL_DB_POOL_MAX=10
CONTENT_DB_POOL_MAX=10
ATTENDANCE_DB_POOL_MAX=10
FILES_DB_POOL_MAX=6
NOTIFICATIONS_DB_POOL_MAX=8
AUDIT_DB_POOL_MAX=6
READ_DB_POOL_MAX=8
PORT=3000
IDENTITY_SERVICE_URL=http://127.0.0.1:3101
SCHOOL_SERVICE_URL=http://127.0.0.1:3102
CONTENT_SERVICE_URL=http://127.0.0.1:3103
ATTENDANCE_SERVICE_URL=http://127.0.0.1:3104
FILE_SERVICE_URL=http://127.0.0.1:3105
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3106
AUDIT_SERVICE_URL=http://127.0.0.1:3107
AUTHORIZATION_SERVICE_URL=http://127.0.0.1:3108
READ_SERVICE_URL=http://127.0.0.1:3109
FEES_SERVICE_URL=http://127.0.0.1:3110
FEES_DATABASE_URL=postgresql://schoolconnect:schoolconnect@localhost:5432/schoolconnect_fees
FEES_DB_POOL_MAX=4
# Free deterministic interpretation is the default; Groq Free or self-hosted Ollama is optional.
FEES_QUERY_PROVIDER=rules
# FEES_QUERY_PROVIDER=groq
# GROQ_API_KEY=configure-only-in-protected-server-environment
# GROQ_FREE_TIER_CONFIRMED=true  # Confirm the account is actually on Free; this cannot verify billing.
# Groq default model is openai/gpt-oss-20b; requests go to Groq, not the OpenAI API.
# FEES_QUERY_PROVIDER=ollama
FEES_AI_BASE_URL=http://127.0.0.1:11434
# FEES_AI_MODEL=your-installed-local-model
# FEES_AI_AUTH_TOKEN=protected-token-for-a-remote-self-hosted-HTTPS-proxy-only
# Set OLLAMA_NO_CLOUD=1 on the Ollama host; do not select cloud models.
FEES_AI_TIMEOUT_MS=15000
FEES_AI_REQUESTS_PER_MINUTE=10
FEES_AI_MAX_CONCURRENT=1
FEES_AI_GLOBAL_REQUESTS_PER_MINUTE=3
FEES_AI_DAILY_REQUESTS=100
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_POLL_INTERVAL_MS=60000
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=schoolconnect-private
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=schoolconnect
S3_SECRET_ACCESS_KEY=schoolconnect-local-only
FILE_URL_TTL_SECONDS=300
FILE_SCANNER_PROVIDER=development-clean
OUTBOX_POLL_INTERVAL_MS=1000
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_EVENT_TOPIC=schoolconnect.domain-events.v1
KAFKA_SSL=false
# KAFKA_CA_CERT_BASE64=base64-encoded-PEM-CA-certificate-for-private-CA-brokers
KAFKA_CREATE_TOPIC=false
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
# KAFKA_SASL_MECHANISM=plain|scram-sha-256|scram-sha-512
# KAFKA_SASL_USERNAME=...
# KAFKA_SASL_PASSWORD=...
# TODO(PRODUCT): select OTP/SMS and push providers before production onboarding.
