# Production NODE_ENV with an explicit synthetic-data-only OTP exception.
# Copy privately; never commit the populated file. This does not activate a cloud deployment.
NODE_ENV=production
DEPLOYMENT_STAGE=trial
ALLOW_MOCK_OTP=true
OTP_PROVIDER=development
DEVELOPMENT_OTP_CODE=123456
RENDER_DEMO_MODE=false
SC_DEMO_SEED=false
# Existing direct Neon URL; sslmode=verify-full, not the transaction pooler.
DATABASE_URL=postgresql://existing-role:existing-password@existing-direct-neon-host/neondb?sslmode=verify-full
# Optional: nine service-specific URLs override DATABASE_URL derivation. Prefer restricted per-service roles.
# Keep these values exactly as currently configured; do not replace them during cutover.
AUTH_JWT_SECRET=copy-the-existing-protected-secret
INTERNAL_SERVICE_TOKEN=copy-the-existing-protected-internal-token
# Keep the effective existing pepper. If absent, JWT secret remains the compatibility fallback.
# PASSCODE_PEPPER=copy-the-existing-protected-pepper
AUTHORIZATION_PROVIDER=local-jwt
RESOURCE_AUTHORIZATION_PROVIDER=policy
# Preserve existing issuer/audience too; these match the former defaults, not a forced rotation.
AUTH_JWT_ISSUER=schoolconnect-identity-local
AUTH_JWT_AUDIENCE=schoolconnect-mobile-local
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_SESSION_IDLE_TTL_DAYS=7
PASSCODE_MAX_ATTEMPTS=5
PASSCODE_LOCK_SECONDS=900
PASSCODE_LOGIN_LIMIT=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_SECONDS=900
OTP_RESEND_AFTER_SECONDS=30
ENFORCE_HTTPS=true
CORS_ALLOWED_ORIGINS=https://schoolconnect-demo-admin.onrender.com
API_AUTH_RATE_LIMIT=120
API_USER_RATE_LIMIT=600
API_RATE_LIMIT_WINDOW_SECONDS=60
PORT=3000
DB_CONNECTION_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=5000
IDENTITY_DB_POOL_MAX=2
SCHOOL_DB_POOL_MAX=2
CONTENT_DB_POOL_MAX=2
ATTENDANCE_DB_POOL_MAX=2
FILES_DB_POOL_MAX=2
NOTIFICATIONS_DB_POOL_MAX=2
AUDIT_DB_POOL_MAX=2
READ_DB_POOL_MAX=2
FEES_DB_POOL_MAX=2
OUTBOX_POLL_INTERVAL_MS=2000
KAFKA_HANDLER_MAX_ATTEMPTS=3
KAFKA_HANDLER_RETRY_DELAY_MS=1000
KAFKA_BROKERS=existing-broker-host:existing-port
KAFKA_SSL=true
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_SASL_USERNAME=copy-existing-protected-username
KAFKA_SASL_PASSWORD=copy-existing-protected-password
# KAFKA_CA_CERT_BASE64=copy-existing-protected-CA
KAFKA_EVENT_TOPIC=schoolconnect.domain-events.v1
KAFKA_CREATE_TOPIC=false
KAFKA_PARTITIONS=2
# Keep disabled until a real scanner and R2 acceptance tests pass. See docs/private-upload-processing.md.
FILE_STORAGE_PROVIDER=disabled
FILE_SCANNER_PROVIDER=disabled
# When enabled, configure real scanner/storage in protected server variables, not mobile build variables:
# FILE_SCANNER_PROVIDER=clamav-http
# FILE_SCANNER_URL=https://your-private-authenticated-scanner.example
# FILE_SCANNER_TOKEN=<independent-random-secret-at-least-32-bytes>
# FILE_STORAGE_BUDGET_BYTES=8000000000
# FILE_SCHOOL_BUDGET_BYTES=2000000000
# FILE_SIGNATURE_MAX_AGE_HOURS=72
# FILE_SCAN_TIMEOUT_MS=40000
FEES_QUERY_PROVIDER=rules
# Preserve existing Groq settings separately if currently enabled; no provider change required.
# MIGRATION_DATABASE_URL belongs only in the release operator's protected environment, not the runtime.
