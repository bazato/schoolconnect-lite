    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@schoolconnect/contracts": "workspace:*",
    "@schoolconnect/eventing": "workspace:*",
    "dotenv": "17.2.2",
    "pdf-lib": "1.17.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "eslint": "9.35.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
