{
  "name": "schoolconnect-lite",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "figma:inspect": "node scripts/inspect-fig.mjs && node scripts/summarize-fig.mjs",
    "dev:mobile": "pnpm --filter @schoolconnect/mobile start",
    "dev:api": "pnpm --filter @schoolconnect/contracts build && pnpm --filter @schoolconnect/api start:dev",
    "dev:services": "pnpm --filter @schoolconnect/contracts build && pnpm --filter @schoolconnect/eventing build && pnpm --parallel --filter @schoolconnect/api --filter @schoolconnect/identity --filter @schoolconnect/school --filter @schoolconnect/content --filter @schoolconnect/attendance --filter @schoolconnect/files --filter @schoolconnect/notifications --filter @schoolconnect/audit --filter @schoolconnect/authorization --filter @schoolconnect/read-model --filter @schoolconnect/fees run start:dev",
    "infra:up": "docker compose up -d postgres",
    "infra:broker:up": "docker compose --profile broker up -d kafka",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "db:verify": "node scripts/verify-databases.mjs",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "typecheck": "pnpm --filter @schoolconnect/contracts build && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @schoolconnect/contracts build && pnpm -r test",
    "test:integration": "node scripts/integration-test.mjs",
    "test:product": "node scripts/product-test.mjs",
    "test:admin-mobile": "node scripts/admin-mobile-regression.mjs",
    "test:accounts": "node scripts/account-management-regression.mjs",
    "test:experiences": "node scripts/school-experiences-regression.mjs",
    "test:teacher-roster:db": "pnpm --filter @schoolconnect/school build && node scripts/teacher-roster-regression.mjs",
    "test:files:db": "pnpm --filter @schoolconnect/contracts build && pnpm --filter @schoolconnect/eventing build && pnpm --filter @schoolconnect/files build && node scripts/file-upload-regression.mjs",
    "test:scanner:gateway": "node --test scripts/clamav-gateway.test.mjs",
    "scanner:gateway": "node scripts/clamav-gateway.mjs",
    "test:fees": "node scripts/fees-regression.mjs",
    "dev:test-stack": "node scripts/start-local-test-stack.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:release:concurrency": "node scripts/release-concurrency-test.mjs",
    "test:release:kafka": "node scripts/release-kafka-test.mjs",
    "test:r2:check": "node scripts/r2-smoke-test.mjs --check",
    "test:r2": "node scripts/r2-smoke-test.mjs --run",
    "test:render-demo": "node --test scripts/render-demo-db.test.mjs",
    "test:runtime": "pnpm --filter @schoolconnect/contracts build && node --test scripts/managed-runtime.test.mjs scripts/render-demo-db.test.mjs scripts/render-cutover.test.mjs",
    "test:android-signing": "node --test scripts/android-signing.test.cjs",
    "start:managed": "node scripts/managed-runtime.mjs",
    "runtime:check": "node scripts/managed-runtime.mjs --check",
    "db:managed:plan": "node scripts/migrate-managed.mjs --plan",
    "db:managed:apply": "node scripts/migrate-managed.mjs --apply",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "openfig-core": "0.4.1"
  }
}
