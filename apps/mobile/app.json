{
  "expo": {
    "name": "Nexqon School App",
    "slug": "schoolconnect-lite",
    "version": "0.1.5",
    "icon": "./assets/nexqon-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "schoolconnect",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.schoolconnect.lite",
      "buildNumber": "3"
    },
    "android": {
      "package": "com.schoolconnect.lite",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/nexqon-icon.png",
        "backgroundColor": "#5D08C9"
      }
    },
    "web": { "bundler": "metro", "favicon": "./assets/nexqon-icon.png" },
    "plugins": [
      "./plugins/with-release-signing.cjs",
      "expo-secure-store",
      "expo-notifications",
      ["expo-splash-screen", {
        "image": "./assets/nexqon-icon.png",
        "imageWidth": 200,
        "resizeMode": "contain",
        "backgroundColor": "#5D08C9"
      }]
    ]
  }
}
